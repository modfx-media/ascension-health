# Server-only. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=

# Payload CMS. Values stay in the host's env dashboard. Do not commit secrets.
PAYLOAD_SECRET=
# Pooled Neon connection string. POSTGRES_URL is used only when DATABASE_URL is unset.
DATABASE_URL=
PREVIEW_SECRET=
# Payload admin/API origin. Use the live domain in production, not a vercel.app host.
NEXT_PUBLIC_SERVER_URL=https://ascensionhealthnv.com
# Public SEO origin. Canonicals, sitemap, and JSON-LD use SITE_ORIGIN, then this.
# *.vercel.app values are ignored.
SITE_ORIGIN=https://ascensionhealthnv.com
NEXT_PUBLIC_SITE_URL=https://ascensionhealthnv.com
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Importer only. Unset is a dry run. CMS_IMPORT_APPLY=1 writes drafts and never publishes.
# CMS_IMPORT_APPLY=
